{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ankavisual-site",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "ankavisual.pro", "custom_domain": true },
    { "pattern": "www.ankavisual.pro", "custom_domain": true }
  ]
}
